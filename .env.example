# -------------------------------------------------------------
# WAYAPP ENTERPRISE ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------

# Mandatory Cryptographic Secret (Required in production: openssl rand -base64 48)
AUTH_SECRET="wayapp_super_secret_auth_key_replace_in_production_min32chars"

# Database Connection
DATABASE_URL="postgresql://wayapp:wayapp_secure_password_2026@localhost:5432/wayapp"
POSTGRES_USER="wayapp"
POSTGRES_PASSWORD="wayapp_secure_password_2026"
POSTGRES_DB="wayapp"

# R2 Automated Backups
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret_key"
R2_BUCKET_NAME="wayapp-backups"
ENCRYPTION_KEY="your_encryption_key_for_backups"

# Meta WhatsApp Cloud API Credentials (Optional here; can be configured in Settings UI)
META_APP_ID=""
META_APP_SECRET=""
META_WABA_ID=""
META_PHONE_NUMBER_ID=""
META_ACCESS_TOKEN=""

# AI Provider API Keys for Bots & Knowledge Base (Optional in env, configurable per-bot)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""

# Web Push VAPID Keys (Generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@gccstartup.com"

# Logging & Environment
NODE_ENV="production"
PORT=3000
LOG_LEVEL="info"
