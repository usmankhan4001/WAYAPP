{
  "openapi": "3.0.3",
  "info": {
    "title": "WAYAPP WhatsApp Gateway REST API",
    "version": "1.0.0",
    "description": "Enterprise Meta Cloud API Gateway & Marketing Automation Platform REST API v1"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "API v1 Endpoint"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    { "ApiKeyAuth": [] },
    { "BearerAuth": [] }
  ],
  "paths": {
    "/auth/token": {
      "post": {
        "summary": "Obtain Bearer JWT Token",
        "description": "Authenticates user credentials and returns a short-lived Bearer JWT token for mobile and API integration",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "admin@gccstartup.com" },
                  "password": { "type": "string", "example": "Secr3tPassword!" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token granted" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/contacts": {
      "get": {
        "summary": "List Contacts (Cursor Paginated)",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Contacts list with cursor" }
        }
      },
      "post": {
        "summary": "Create or Upsert Contact",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phoneNumber": { "type": "string", "example": "+971501234567" },
                  "firstName": { "type": "string", "example": "John" },
                  "lastName": { "type": "string", "example": "Doe" },
                  "email": { "type": "string", "example": "john@example.com" },
                  "tags": { "type": "array", "items": { "type": "string" }, "example": ["VIP", "Lead"] },
                  "customAttributes": { "type": "object", "example": { "city": "Dubai", "company": "Acme Corp" } }
                },
                "required": ["phoneNumber"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Contact created or updated" }
        }
      }
    },
    "/messages": {
      "post": {
        "summary": "Send WhatsApp Message",
        "description": "Sends a text message (subject to 24-hour customer window) or a WhatsApp Template message.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to": { "type": "string", "example": "+971501234567" },
                  "type": { "type": "string", "enum": ["text", "template", "image", "document", "video"], "default": "text" },
                  "text": { "type": "string", "example": "Hello! How can we assist you?" },
                  "templateName": { "type": "string", "example": "order_confirmation_v1" },
                  "languageCode": { "type": "string", "default": "en_US" },
                  "bodyVariables": { "type": "array", "items": { "type": "string" }, "example": ["John", "ORD-12345"] },
                  "mediaUrl": { "type": "string", "example": "https://example.com/invoice.pdf" }
                },
                "required": ["to"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Message dispatched to Meta Cloud API" },
          "403": { "description": "24-hour window restriction - template required" }
        }
      }
    },
    "/templates": {
      "get": {
        "summary": "List WhatsApp Approved Templates",
        "responses": {
          "200": { "description": "Synced template components and languages" }
        }
      }
    },
    "/campaigns": {
      "get": {
        "summary": "List Campaigns",
        "responses": { "200": { "description": "Campaign list" } }
      },
      "post": {
        "summary": "Create Broadcast Campaign",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "Ramadan Special Promo" },
                  "templateId": { "type": "string" },
                  "audienceFilter": { "type": "object" },
                  "variableMappings": { "type": "object" },
                  "startImmediately": { "type": "boolean", "default": false }
                },
                "required": ["name", "templateId"]
              }
            }
          }
        },
        "responses": { "201": { "description": "Campaign created" } }
      }
    },
    "/analytics": {
      "get": {
        "summary": "Analytics & Gateway Overview",
        "responses": { "200": { "description": "Aggregate broadcast and messaging metrics" } }
      }
    }
  }
}
