# -------------------------------------------------------------
# WAYAPP ENTERPRISE ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------

# Mandatory Cryptographic Secrets
# Required in production. Generate each with: openssl rand -base64 48
# AUTH_SECRET signs session JWTs. JWT_SECRET / ENCRYPTION_KEY are accepted
# as alternatives; if none is set the app refuses to start (fail-closed).
AUTH_SECRET=""
# ENCRYPTION_KEY=""
# JWT_SECRET=""

# Database Connection (PostgreSQL — production, Docker and local dev)
DATABASE_URL="postgresql://wayapp:wayapp_secure_password_2026@localhost:5432/wayapp"

# Meta WhatsApp Cloud API Credentials (Optional here; can be configured in Settings UI)
META_APP_ID=""
META_APP_SECRET=""

# AI Provider API Keys for Bots & Knowledge Base (Optional in env, configurable per-bot)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Web Push VAPID Keys (Generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@gccstartup.com"

# Bootstrap admin (used by `npm run db:seed -- --force`; defaults shown)
ADMIN_EMAIL="admin@gccstartup.com"
ADMIN_PASSWORD="change-me-now"

# Logging & Environment
NODE_ENV="production"
LOG_LEVEL="info"
