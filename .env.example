# -------------------------------------------------------------
# WAYAPP ENTERPRISE ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------

# Mandatory Cryptographic Secret (Required in production: openssl rand -base64 48)
AUTH_SECRET="wayapp_super_secret_auth_key_replace_in_production_min32chars"

# Database Connection (PostgreSQL for production / Docker, SQLite for local dev)
DATABASE_URL="postgresql://wayapp:wayapp_secure_password_2026@localhost:5432/wayapp"
# DATABASE_URL="file:./dev.db"

# Meta WhatsApp Cloud API Credentials (Optional here; can be configured in Settings UI)
META_APP_ID=""
META_APP_SECRET=""
META_WABA_ID=""
META_PHONE_NUMBER_ID=""
META_ACCESS_TOKEN=""

# AI Provider API Keys for Bots & Knowledge Base (Optional in env, configurable per-bot)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""

# Web Push VAPID Keys (Generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@gccstartup.com"

# Logging & Environment
NODE_ENV="production"
PORT=3000
LOG_LEVEL="info"
